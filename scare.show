display:flex;
    animation:flashbg .15s steps(2) 6, shake .08s linear infinite;
  }
  @keyframes flashbg{
    0%{background:#000;}
    50%{background:#8b0000;}
    100%{background:#000;}
  }
  @keyframes shake{
    0%{transform:translate(0,0);}
    25%{transform:translate(-12px,8px);}
    50%{transform:translate(10px,-10px);}
    75%{transform:translate(-8px,-6px);}
    100%{transform:translate(6px,10px);}
  }
  /* Reveal */
  #reveal{
    display:none;
    text-align:center;
    z-index:2;
    padding:20px;
  }
  #reveal h1{
    font-family:'Creepster',cursive;
    font-size:2.4rem;
    color:#4dff4d;
  }
  #reveal p{
    margin-top:12px;
    color:#aaa;
    font-family:sans-serif;
  }
  #reveal button{
    margin-top:25px;
    padding:10px 24px;
    background:#4dff4d;
    border:none;
    font-weight:bold;
    cursor:pointer;
  }
  .hidden{display:none !important;}
</style>
</head>
<body>

<div class="vignette"></div>

<div id="intro">
  <h1>IS GHAR MEIN KOI HAI...</h1>
  <p>Andar aane se pehle soch lo. Wapas jaane ka rasta nahi milega.</p>
  <div id="typedLine"></div>
  <button id="enterBtn">Andar Jao (Agar Himmat Hai)</button>
</div>

<div id="scan">
  <h2 id="scanText">SYSTEM SCANNING...</h2>
  <div class="bar"><div class="bar-fill" id="barFill"></div></div>
</div>

<div id="scare">
  <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
    <ellipse cx="100" cy="110" rx="90" ry="85" fill="#0a0a0a" stroke="#550000" stroke-width="3"/>
    <circle cx="65" cy="95" r="22" fill="#ff0000"/>
    <circle cx="135" cy="95" r="22" fill="#ff0000"/>
    <circle cx="65" cy="95" r="8" fill="#000"/>
    <circle cx="135" cy="95" r="8" fill="#000"/>
    <path d="M50 150 Q100 190 150 150 L150 165 Q100 200 50 165 Z" fill="#fff"/>
    <path d="M55 150 L65 165 L75 150 M85 150 L95 165 L105 150 M115 150 L125 165 L135 150" stroke="#000" stroke-width="2" fill="none"/>
  </svg>
</div>

<div id="reveal">
  <h1>GOTCHA! 😂</h1>
  <p>Bas ek prank tha yaar, relax ho jao. Ab isko apne dost ko bhej ke revenge lo.</p>
  <button onclick="location.reload()">Dobara Darao</button>
</div>

<script>
const intro = document.getElementById('intro');
const scan = document.getElementById('scan');
const scare = document.getElementById('scare');
const reveal = document.getElementById('reveal');
const enterBtn = document.getElementById('enterBtn');
const typedLine = document.getElementById('typedLine');
const scanText = document.getElementById('scanText');
const barFill = document.getElementById('barFill');

// creepy typing effect on load
const lines = ["...tum akele nahi ho", "...koi tumhe dekh raha hai", "...peeche mat dekhna"];
let li = 0, ci = 0;
function typeLoop(){
  if(li >= lines.length){ setTimeout(()=>{li=0; typedLine.textContent=''; typeLoop();}, 1500); return; }
  const line = lines[li];
  if(ci <= line.length){
    typedLine.textContent = line.slice(0, ci);
    ci++;
    setTimeout(typeLoop, 70);
  } else {
    ci = 0; li++;
    setTimeout(typeLoop, 900);
  }
}
typeLoop();

// synthesize a horror "stinger" sound with Web Audio (no external files needed)
function playScare(){
  try{
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    const ctx = new AudioCtx();

    // low thump
    const osc1 = ctx.createOscillator();
    const gain1 = ctx.createGain();
    osc1.type = 'sawtooth';
    osc1.frequency.setValueAtTime(180, ctx.currentTime);
    osc1.frequency.exponentialRampToValueAtTime(35, ctx.currentTime + 0.6);
    gain1.gain.setValueAtTime(0.9, ctx.currentTime);
    gain1.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.8);
    osc1.connect(gain1).connect(ctx.destination);
    osc1.start(); osc1.stop(ctx.currentTime + 0.8);

    // high shriek
    const osc2 = ctx.createOscillator();
    const gain2 = ctx.createGain();
    osc2.type = 'square';
    osc2.frequency.setValueAtTime(1200, ctx.currentTime);
    osc2.frequency.exponentialRampToValueAtTime(500, ctx.currentTime + 0.3);
    gain2.gain.setValueAtTime(0.25, ctx.currentTime);
    gain2.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);
    osc2.connect(gain2).connect(ctx.destination);
    osc2.start(); osc2.stop(ctx.currentTime + 0.35);

    // noise burst
    const bufferSize = ctx.sampleRate * 0.4;
    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
    const data = buffer.getChannelData(0);
    for(let i=0;i<bufferSize;i++){ data[i] = (Math.random()*2-1) * (1 - i/bufferSize); }
    const noise = ctx.createBufferSource();
    noise.buffer = buffer;
    const noiseGain = ctx.createGain();
    noiseGain.gain.setValueAtTime(0.5, ctx.currentTime);
    noise.connect(noiseGain).connect(ctx.destination);
    noise.start();
  }catch(e){ /* audio blocked, ignore silently */ }
}

enterBtn.addEventListener('click', () => {
  intro.classList.add('hidden');
  scan.style.display = 'block';

  let pct = 0;
  const scanMsgs = ["ACCESSING FILES...", "SOMETHING FOUND...", "DO NOT CLOSE THIS TAB..."];
  const interval = setInterval(() => {
    pct += Math.random()*10 + 5;
    if(pct > 100) pct = 100;
    barFill.style.width = pct + '%';
    if(pct > 30 && pct < 60) scanText.textContent = scanMsgs[1];
    if(pct > 60) scanText.textContent = scanMsgs[2];
    if(pct >= 100){
      clearInterval(interval);
      setTimeout(triggerScare, 500);
    }
  }, 180);
});

function triggerScare(){
  scan.style.display = 'none';
  scare.classList.add('show');
  playScare();
  navigator.vibrate && navigator.vibrate([100,50,100,50,200]);

  setTimeout(() => {
    scare.classList.remove('show');
    reveal.style.display = 'block';
  }, 1600);
}
</script>
</body>
</html>

Bas is index.html ko save kar ke double-click se kholna — button dabate hi "scan" chalega, phir jump scare + scary sound aayega, aur end mein "Gotcha 😂" reveal ho jayega. Chaho to timing, text, ya scary face design change karwa lo, bata dena.